{
  "name": "fluentgraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev -w @fluentgraph/server' 'npm run dev -w @fluentgraph/client'",
    "build": "npm run build -w @fluentgraph/client && npm run build -w @fluentgraph/server",
    "start": "node packages/server/dist/server/src/index.js",
    "test": "node --test packages/server/test/*.test.ts packages/client/test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p packages/server/tsconfig.json && tsc --noEmit -p packages/client/tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
